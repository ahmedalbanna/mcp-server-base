# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MCP Configuration
MCP_SERVER_NAME=mcp-server-base
MCP_SERVER_VERSION=3.0.0

# Logging
LOG_LEVEL=info # debug|info|warn|error
LOG_FORMAT=text # text|json (json for production)

# Security (Phase 2)
# AUTH_MODE: none | apiKey | bearer
AUTH_MODE=none
# API_KEY required when AUTH_MODE=apiKey (send via X-API-Key header)
# API_KEY=your-secret-api-key
# BEARER_TOKEN or AUTH_TOKEN required when AUTH_MODE=bearer (send via Authorization: Bearer <token>)
# BEARER_TOKEN=your-bearer-token

# CORS (comma-separated or * )
CORS_ORIGIN=*

# Rate Limit (MCP endpoint)
RATE_LIMIT_WINDOW_MS=900000 # 15 min
RATE_LIMIT_MAX=100

# Resumability (Last-Event-ID replay)
RESUMABILITY_ENABLED=false # true to enable stateful + InMemoryEventStore

# Phase 3 Capabilities
ALLOWED_ROOT=/tmp/mcp-data # sandboxed filesystem root (all file ops under this)
ALLOW_SHELL=false # true to enable shell_execute (allowlist only)
SHELL_ALLOWLIST=ls,cat,echo,pwd,head,tail,grep # comma-separated allowed commands
DATABASE_PATH=:memory: # alasql in-memory, or file path

# Phase 4 Integrations
# RAG
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# Cache
CACHE_TTL_MS=300000 # 5 min
REDIS_URL=redis://localhost:6379 # optional, falls back to memory
QDRANT_URL=http://localhost:6333 # optional vector DB (fallback to memory)
# Integrations
BRAVE_API_KEY= # for brave_search (mock if empty)
TAVILY_API_KEY= # for tavily_search (mock if empty)
OPENAI_API_KEY= # for rag embeddings (fallback to local hash)
GITHUB_TOKEN= # for github_* higher rate limit

# Phase 5 Scale & Operability
OTEL_ENABLED=false # true to enable tracing/metrics
OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. http://localhost:4318/v1/traces
ADMIN_ENABLED=true # enable /admin dashboard
ADMIN_TOKEN= # optional bearer for /admin (X-Admin-Token)
TASKS_ENABLED=false # experimental tasks API (requires taskStore)
EVENT_STORE_TYPE=memory # memory|redis (redis needs REDIS_URL)
# API Keys (example)
# OPENAI_API_KEY=sk-...
# BRAVE_API_KEY=...
